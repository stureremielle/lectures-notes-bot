# lectures-notes-bot — secrets for local development only.
# In the Portainer stack these live in the stack's `environment:` block instead
# (no env_file).

# OpenAI-compatible endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Discord webhooks: one per channel
DISCORD_NOTES_WEBHOOK=https://discord.com/api/webhooks/xxx/notes
DISCORD_CALENDAR_WEBHOOK=https://discord.com/api/webhooks/xxx/calendar
