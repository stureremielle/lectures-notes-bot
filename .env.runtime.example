# Template for scripts/recreate.sh — used when no container exists to read the
# environment from (fresh box, or Docker data root lost).
#
# Copy to .env.runtime (gitignored, chmod 600) and fill in:
#   cp .env.runtime.example .env.runtime && chmod 600 .env.runtime
#   nano .env.runtime
#
# recreate.sh then recreates the container with `docker run --env-file`, so the
# secrets never appear on a command line or in shell history.

TZ=Asia/Makassar
OPENAI_BASE_URL=https://api.cosmoshub.tech/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4.1-flash
DISCORD_NOTES_WEBHOOK=
DISCORD_CALENDAR_WEBHOOK=
